{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BroTalk",
  "version": "1.1.0",
  "identifier": "com.brotalk.voicechanger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BroTalk - System Voice Changer & Sampler",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/punitcs7/BroTalk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQzQ5NzYxQkJBMTE1MkQKUldRdEZhRzdZWmZFL0c5b0hKV0RDYVBzTHNmQ2lhcUhaTkc0UHhsUFR2VVVhNTRDQlJ6WFUyQjUK"
    }
  }
}
